# Server Configuration
server.port=8080

# AWS Configuration
aws.region=${AWS_REGION:us-east-1}
aws.dynamodb.endpoint=https://dynamodb.${aws.region}.amazonaws.com
aws.accessKeyId=${AWS_ACCESS_KEY_ID}
aws.secretAccessKey=${AWS_SECRET_ACCESS_KEY}

# Payment Encryption Configuration
payment.encryption.key=${PAYMENT_ENCRYPTION_KEY}

# Stripe Configuration
stripe.secret.key=${STRIPE_SECRET_KEY}
stripe.public.key=${STRIPE_PUBLIC_KEY}
stripe.webhook.secret=${STRIPE_WEBHOOK_SECRET}

# JWT Configuration
jwt.secret=${JWT_SECRET}
jwt.expiration=86400000
jwt.refresh-expiration=604800000


# OAuth2 Configuration - Google
spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID}
spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_CLIENT_SECRET}
spring.security.oauth2.client.registration.google.scope=profile,email
spring.security.oauth2.client.registration.google.redirect-uri={baseUrl}/login/oauth2/code/google

spring.security.oauth2.client.provider.google.authorization-uri=https://accounts.google.com/o/oauth2/v2/auth
spring.security.oauth2.client.provider.google.token-uri=https://oauth2.googleapis.com/token
spring.security.oauth2.client.provider.google.user-info-uri=https://www.googleapis.com/oauth2/v3/userinfo
spring.security.oauth2.client.provider.google.user-name-attribute=sub

# OAuth2 Redirect URI (Frontend)
app.oauth2.redirectUri=${OAUTH2_REDIRECT_URI:https://allyticlabs-frontend.vercel.app/oauth2/redirect}

# CORS Configuration
app.cors.allowed-origins=https://allyticlabs-frontend.vercel.app,https://allyticlabs-frontend.vercel.app,https://allyticlabs-frontend.vercel.app,http://localhost:4173,https://ailytic-labs-frontend.vercel.app

# M-Pesa Daraja API Configuration
# Get credentials from: https://developer.safaricom.co.ke
mpesa.consumer-key=${MPESA_CONSUMER_KEY}
mpesa.consumer-secret=${MPESA_CONSUMER_SECRET}
mpesa.passkey=${MPESA_PASSKEY}
mpesa.short-code=${MPESA_SHORT_CODE}
mpesa.initiator-name=${MPESA_INITIATOR_NAME:testapi}
mpesa.initiator-password=${MPESA_INITIATOR_PASSWORD}

# M-Pesa Environment (sandbox or production)
mpesa.environment=${MPESA_ENVIRONMENT:sandbox}

# M-Pesa API URLs (Sandbox)
mpesa.oauth-url=/oauth/v1/generate?grant_type=client_credentials
mpesa.stk-push-url=/mpesa/stkpush/v1/processrequest
mpesa.stk-query-url=/mpesa/stkpushquery/v1/query
mpesa.c2b-register-url=/mpesa/c2b/v1/registerurl
mpesa.c2b-simulate-url=/mpesa/c2b/v1/simulate
mpesa.reversal-url=/mpesa/reversal/v1/request
mpesa.transaction-status-url=/mpesa/transactionstatus/v1/query
mpesa.account-balance-url=/mpesa/accountbalance/v1/query

# M-Pesa Callback URLs (Update with your actual URLs)
mpesa.callback-url=${MPESA_CALLBACK_URL:http://localhost:8080/api/v1/payments/mpesa/callback}
mpesa.timeout-url=${MPESA_TIMEOUT_URL:http://localhost:8080/api/v1/payments/mpesa/timeout}
mpesa.result-url=${MPESA_RESULT_URL:http://localhost:8080/api/v1/payments/mpesa/result}
mpesa.validation-url=${MPESA_VALIDATION_URL:http://localhost:8080/api/v1/payments/mpesa/validate}
mpesa.confirmation-url=${MPESA_CONFIRMATION_URL:http://localhost:8080/api/v1/payments/mpesa/confirm}

# M-Pesa Timeouts
mpesa.connection-timeout=30000
mpesa.read-timeout=30000

# Logging
logging.level.root=INFO
logging.level.com.allyticlabs=DEBUG
logging.level.org.springframework.web.cors=DEBUG